{
  "name": "arhdesign",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:ui": "start-server-and-test 'npm run dev -- --hostname 127.0.0.1 --port 3100' http://127.0.0.1:3100 'cypress run'",
    "test:ui:open": "cypress open",
    "test:qa": "npm run test:coverage && npm run test:ui",
    "lint:openapi": "redocly lint openapi/contact-api.yaml openapi/account-api.yaml",
    "test:load:r1": "node scripts/r1-load-test.mjs",
    "validate:frontend-adapter": "bash scripts/validate-adapters.sh frontend",
    "validate:openapi-adapter": "bash scripts/validate-adapters.sh openapi",
    "validate:postgres-adapter": "bash scripts/validate-adapters.sh postgres",
    "validate:api-adapter": "bash scripts/validate-adapters.sh api",
    "validate:adapters": "bash scripts/validate-adapters.sh all"
  },
  "dependencies": {
    "@hookform/resolvers": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "next": "^16.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "latest",
    "tailwind-merge": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@playwright/test": "^1.63.0",
    "@redocly/cli": "^2.54.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitest/coverage-v8": "latest",
    "cypress": "^15.3.0",
    "eslint": "latest",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^29.1.1",
    "start-server-and-test": "^2.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "latest"
  }
}
